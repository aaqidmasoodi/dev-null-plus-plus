{
  "name": "dev-null-plus-plus",
  "description": "Extra powers for dev-null.sh, the social network for developers.",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "wxt build && playwright test",
    "check": "npm run compile && npm run lint && npm run format:check && npm run test",
    "postinstall": "wxt prepare",
    "test:e2e:firefox": "wxt zip -b firefox && node --experimental-strip-types e2e/firefox/smoke.ts",
    "media": "node --experimental-strip-types scripts/media/render.ts",
    "media:themes": "node --experimental-strip-types scripts/media/themes.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/fredoka": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource-variable/pixelify-sans": "5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/selenium-webdriver": "^4.35.7",
    "@wxt-dev/auto-icons": "^1.1.2",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.3",
    "prettier": "^3.9.10",
    "selenium-webdriver": "^4.51.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0"
  }
}
